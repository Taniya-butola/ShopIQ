# PriceWise Production Environment Variables
# Copy this file to .env and fill in your values

# Secret key for Flask sessions (generate a random string)
SECRET_KEY=your-secret-key-change-this-in-production

# Flask environment
FLASK_ENV=production
PORT=5000

# Cache TTL in seconds (default: 1 hour)
CACHE_TTL=3600

# Max concurrent scrapers
MAX_SCRAPERS=5

# SerpAPI Configuration (for Google Shopping results)
SERPAPI_API_KEY=your-serpapi-key
SERPAPI_GL=in
SERPAPI_HL=en
SERPAPI_LOCATION=India

# MongoDB (optional - uses Docker service by default)
# MONGO_URI=mongodb://mongo:27017/pricewise

# Redis (optional - uses Docker service by default)
# REDIS_URL=redis://redis:6379/0

# Email alerts configuration (optional)
ALERT_EMAIL=your-email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# OpenAI API (optional - for ML features)
# OPENAI_API_KEY=sk-your-key
